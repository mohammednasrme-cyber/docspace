# Production Environment Variables for DocSpace Backend
# Deploy to Railway with these values

# Database connection (Supabase or Railway PostgreSQL)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public&connection_limit=5"

# API Configuration
PORT=3001
NODE_ENV=production

# Frontend URL for CORS (your Vercel deployment)
FRONTEND_URL="https://your-docspace-frontend.vercel.app"

# JWT Secrets - generate with: openssl rand -hex 48
JWT_ACCESS_SECRET="your-long-random-access-secret-here-minimum-32-characters"
JWT_REFRESH_SECRET="your-long-random-refresh-secret-here-minimum-32-characters"

# Token Expiration
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# Cookie Security (MUST be true in production)
COOKIE_SECURE=true

# Optional: Add if using a CDN or proxy
TRUSTED_PROXY="*"

# Optional: Rate limiting (uncomment if needed)
# RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
# RATE_LIMIT_MAX=100           # 100 requests per window