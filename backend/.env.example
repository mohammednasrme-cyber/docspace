# PostgreSQL connection string
DATABASE_URL="postgresql://docspace:docspace@localhost:5433/docspace?schema=public"

# API
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Auth - generate long random values for production (e.g. openssl rand -hex 48)
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# Set true when cookies must be sent over HTTPS in production.
COOKIE_SECURE=false
