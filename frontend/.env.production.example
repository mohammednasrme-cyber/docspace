# Production Environment Variables for DocSpace Frontend
# Deploy to Vercel with these values

# Backend API URL (your Railway deployment)
BACKEND_URL="https://your-docspace-backend.railway.app"

# Optional: Analytics or monitoring
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# Note: Next.js public variables must be prefixed with NEXT_PUBLIC_
# Other variables are server-side only